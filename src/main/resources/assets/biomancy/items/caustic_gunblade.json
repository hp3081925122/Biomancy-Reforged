{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui", "fixed"],
          "model": {
            "type": "minecraft:model",
            "model": "biomancy:item/caustic_gunblade_ranged_icon"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:special",
        "base": "biomancy:item/caustic_gunblade_ranged_display",
        "model": {
          "type": "geckolib:geckolib"
        }
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui", "fixed"],
          "model": {
            "type": "minecraft:model",
            "model": "biomancy:item/caustic_gunblade_melee_icon"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:special",
        "base": "biomancy:item/caustic_gunblade_melee_display",
        "model": {
          "type": "geckolib:geckolib"
        }
      }
    }
  }
}
